# 单位换算 —— 纯 sahou 实现的常用单位换算（v2 标准库 stones 包）
# 长度/重量/数据大小走"换算系数表"（字典），温度走公式。
# 不认识的单位会抛错并列出支持的单位名。

# 长度系数表：以"米"为单位
长度系数 = { "毫米": 0.001, "厘米": 0.01, "米": 1, "公里": 1000, "英寸": 0.0254, "英尺": 0.3048, "英里": 1609.344 }

# 重量系数表：以"千克"为单位
重量系数 = { "克": 0.001, "千克": 1, "吨": 1000, "盎司": 0.028349523125, "磅": 0.45359237 }

# 数据大小系数表：以"字节"为单位（1024 进制）
数据系数 = { "字节": 1, "KB": 1024, "MB": 1048576, "GB": 1073741824, "TB": 1099511627776 }

# 长度换算：长度换算(100, "公里", "英里")
函数 长度换算(数量, 从单位, 到单位)
    返回 经系数(长度系数, "长度", 数量, 从单位, 到单位)
完毕

# 重量换算：重量换算(5, "千克", "磅")
函数 重量换算(数量, 从单位, 到单位)
    返回 经系数(重量系数, "重量", 数量, 从单位, 到单位)
完毕

# 数据大小换算：数据换算(3, "GB", "MB")
函数 数据换算(数量, 从单位, 到单位)
    返回 经系数(数据系数, "数据大小", 数量, 从单位, 到单位)
完毕

# 经系数：先换到基准单位，再换到目标单位；单位名拼错时抛出可读错误
函数 经系数(系数表, 类名, 数量, 从单位, 到单位)
    如果 非 包含(系数表, 从单位)
        抛出("不认识这个{类名}单位 \"{从单位}\"。支持：" + 连接(列表(系数表), "、") + "。")
    完毕
    如果 非 包含(系数表, 到单位)
        抛出("不认识这个{类名}单位 \"{到单位}\"。支持：" + 连接(列表(系数表), "、") + "。")
    完毕
    返回 数量 * 系数表[从单位] / 系数表[到单位]
完毕

# 温度换算：温度换算(37, "摄氏", "华氏")。刻度名：摄氏 / 华氏 / 开氏
函数 温度换算(度数, 从刻度, 到刻度)
    # 先统一换到摄氏
    如果 从刻度 == "摄氏"
        摄 = 度数
    又如 从刻度 == "华氏"
        摄 = (度数 - 32) * 5 / 9
    又如 从刻度 == "开氏"
        摄 = 度数 - 273.15
    否则
        抛出("不认识这个温度刻度 \"{从刻度}\"。支持：摄氏、华氏、开氏。")
    完毕
    # 再从摄氏换到目标
    如果 到刻度 == "摄氏"
        返回 摄
    完毕
    如果 到刻度 == "华氏"
        返回 摄 * 9 / 5 + 32
    完毕
    如果 到刻度 == "开氏"
        返回 摄 + 273.15
    完毕
    抛出("不认识这个温度刻度 \"{到刻度}\"。支持：摄氏、华氏、开氏。")
完毕
