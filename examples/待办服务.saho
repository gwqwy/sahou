# 待办事项 REST 服务（v1.1 网络模块）——内存存储：查、增、删
待办 = {}
状态 = { "下一个序号": 1 }

函数 列出(请求)
    结果 = []
    for 键 于 待办
        结果.添加(待办[键])
    完毕
    返回 { "状态": 200, "头": { "Content-Type": "application/json" }, "体": 网络.到文本(结果) }
完毕

函数 新增(请求)
    条目 = 网络.自文本(请求["体"])
    序号 = 状态["下一个序号"]
    条目["序号"] = 序号
    状态["下一个序号"] = 序号 + 1
    待办[文本(序号)] = 条目
    返回 { "状态": 201, "体": 网络.到文本(条目) }
完毕

函数 删除(请求)
    键 = 请求["查询"]["序号"]
    如果 包含(待办, 键)
        待办.删除(键)
        返回 { "状态": 200, "体": "已删除序号 {键}" }
    完毕
    返回 { "状态": 404, "体": "没有序号 {键} 的待办" }
完毕

服务 = 网络.服务()
服务.路由("GET", "/待办", 列出)
服务.路由("POST", "/待办", 新增)
服务.路由("DELETE", "/待办", 删除)
print("待办服务已启动：http://localhost:8080")
服务.监听(8080)
