{
  "函数定义": {
    "prefix": "fn",
    "body": [
      "函数 ${1:名字}(${2:参数})",
      "\t${3:返回 ${4:值}}",
      "完毕"
    ],
    "description": "定义一个函数"
  },
  "匿名函数": {
    "prefix": "anon",
    "body": "函数(${1:x}) => ${2:${1:x}}"
  },
  "如果语句": {
    "prefix": "if",
    "body": [
      "如果 ${1:条件}",
      "\t${2:print(\"是\")}",
      "完毕"
    ]
  },
  "如果否则": {
    "prefix": "ifelse",
    "body": [
      "如果 ${1:条件}",
      "\t${2:print(\"是\")}",
      "否则",
      "\t${3:print(\"否\")}",
      "完毕"
    ]
  },
  "如果又如": {
    "prefix": "elif",
    "body": [
      "如果 ${1:条件一}",
      "\t${2}",
      "又如 ${3:条件二}",
      "\t${4}",
      "否则",
      "\t${5}",
      "完毕"
    ]
  },
  "当循环": {
    "prefix": "while",
    "body": [
      "当 ${1:条件}",
      "\t${2}",
      "完毕"
    ]
  },
  "遍历循环": {
    "prefix": "for",
    "body": [
      "遍历 ${1:x} 于 ${2:列表}",
      "\t${3:print(${1:x})}",
      "完毕"
    ]
  },
  "尝试接住": {
    "prefix": "try",
    "body": [
      "尝试",
      "\t${1}",
      "接住 ${2:错误信息}",
      "\t${3:print(\"出错了: {${2:错误信息}}\")}",
      "完毕"
    ]
  },
  "引入模块": {
    "prefix": "use",
    "body": "用 \"${1:模块名}\" 引入",
    "description": "用 … 引入 一个模块或 stones 包"
  },
  "打印": {
    "prefix": "pr",
    "body": "print(\"${1:{值}\\}\")"
  },
  "管道": {
    "prefix": "pipe",
    "body": "${1:值} -> ${2:排序} -> ${3:打印}",
    "description": "数据流水线：值 -> 步骤 -> 步骤（全角 → 等价）"
  },
  "写页面": {
    "prefix": "page",
    "body": [
      "页 = 应用.写页面(\"${1:标题}\", ${2:420}, ${3:320})",
      "${4:反馈} = 页.标签(\"${5:欢迎}\")",
      "页.按钮(\"${6:点我}\", ${7:处理函数})",
      "页.显示()"
    ],
    "description": "纯代码写页面：窗口 + 控件 + 事件（应用.写页面）"
  }
}
