# 响应式价格计算器 —— 没有任何事件处理代码，改输入，结果自动更新
# 运行：sahou serve 本目录，然后浏览器打开 价格计算.html

单价 = 3.5
数量 = 2

格子 总价 = 单价 * 数量
格子 提示 = "单价 {单价} 元 × 数量 {数量} = {总价} 元"

单价输入 = 页面.取元素("#单价")
数量输入 = 页面.取元素("#数量")
总价显示 = 页面.取元素("#总价")
提示显示 = 页面.取元素("#提示")

# 输入框直接驱动变量；格子变化自动刷新显示——这就是响应式计算模型
页面.绑输入(单价输入, "单价")
页面.绑输入(数量输入, "数量")
页面.绑定(总价显示, "总价")
页面.绑定(提示显示, "提示")
