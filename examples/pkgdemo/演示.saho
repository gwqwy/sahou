# stones 标准库包演示 —— 在 examples/ 子目录里也能用到仓库根的 stones/（向上查找）
用 "算术库" 引入
用 "文本库" 引入
用 "游戏库" 引入
用 "中文数字" 引入
用 "统计库" 引入
用 "单位换算" 引入
用 "进制库" 引入
用 "几何库" 引入
用 "算法库" 引入
用 "集合运算" 引入
用 "数列库" 引入
用 "逻辑库" 引入
用 "密码库" 引入
用 "日期库" 引入
用 "罗马数字" 引入
用 "分数库" 引入
用 "矩阵库" 引入
用 "时长库" 引入

print("公约数: {算术库.最大公约数(12, 18)}")
print("约分: {算术库.约分(36, 48)}")
print("质因数分解: {算术库.质因数分解(360)}")
print("是否质数: {算术库.是否质数(97)}")
print("阶乘: {算术库.阶乘(6)}")

print(文本库.居中("卅", 11, "-"))
print("回文: {文本库.是否回文("上海自来水来自海上")}")
print("字符统计: {文本库.统计字符("abracadabra")}")
print("驼峰: {文本库.驼峰命名("user_name")}")

随机.种子(3)
print("掷骰子: {游戏库.掷骰子(6)}")
print("抛硬币: {游戏库.抛硬币()}")
print("抽奖: {游戏库.抽奖(["小明", "小红", "小刚", "小丽"], 2)}")

print("95 = {中文数字.到中文(95)}")
print("12345678 = {中文数字.到中文(12345678)}")
print("回转: {中文数字.到数(中文数字.到中文(2026))}")

分数 = [95, 58, 72, 88, 60]
print("平均: {统计库.平均值(分数)}")
print("中位数: {统计库.中位数(分数)}")
print("标准差: {统计库.标准差(分数)}")

print("体温: {单位换算.温度换算(37, "摄氏", "华氏")}")
print("百公里: {单位换算.长度换算(100, "公里", "英里")}")

print("255 的十六进制: {进制库.到十六进制(255)}")
print("FF 的十进制: {进制库.自十六进制("FF")}")
print("勾股斜边: {几何库.勾股斜边(3, 4)}")
print("海伦面积: {几何库.海伦面积(3, 4, 5)}")
print("冒泡排序: {算法库.冒泡排序([5, 2, 8, 1])}")
print("二分查找: {算法库.二分查找([1, 2, 5, 8], 5)}")
print("交集: {集合运算.交集([1,2,3], [2,3,4])}")
print("对称差: {集合运算.对称差([1,2,3], [2,3,4])}")

print("斐波那契: {数列库.斐波那契(8)}")
print("完美数: {数列库.是否完美数(28)}")
print("水仙花: {数列库.是否水仙花数(153)}")
print("角谷: {数列库.角谷数列(6)}")
并且函数 = 函数(a, b) => a 并且 b
真值表 = 逻辑库.真值表(并且函数)
print("异或: {逻辑库.异或(真, 假)}")
print("蕴含: {逻辑库.蕴含(假, 真)}")
print("真值表首行: {真值表[0]["结果"]}，共 {长度(真值表)} 行")
print("凯撒: {密码库.凯撒加密("Hello, 卅", 3)}")
print("解回: {密码库.凯撒解密(密码库.凯撒加密("ATTACK", 3), 3)}")
print("摩斯: {密码库.摩斯编码("SOS 2026")}")
print("栅栏: {密码库.栅栏解密(密码库.栅栏加密("ABCDEFGH", 3), 3)}")
print("闰年: {日期库.是否闰年(2024)}")
print("星期: {日期库.星期几(2026, 9, 19)}")
print("相隔: {日期库.相隔天数(2026, 1, 1, 2026, 10, 1)} 天")

print("2026 = {罗马数字.到罗马(2026)}")
print("回转: {罗马数字.自罗马("XCV")}")
print("1/2 + 1/3 = {分数库.分数文本(分数库.加([1,2], [1,3]))}")
print("带分数: {分数库.带分数文本([7,3])}")
print("乘积: {矩阵库.乘([[1,2],[3,4]], [[0,1],[1,0]])}")
print("行列式: {矩阵库.行列式([[1,2],[3,4]])}")
print(矩阵库.矩阵文本(矩阵库.单位矩阵(2)))
print("时长: {时长库.时长文本(5025)}")
print("钟表: {时长库.钟表文本(5025)}")
print("汉诺塔: {算法库.汉诺塔(3)}")
print("八皇后解数: {长度(算法库.八皇后())}")
