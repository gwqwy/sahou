# 中文数字 —— 纯 sahou 实现的数 ↔ 中文互转（整数 0 到 9999）

数位 = ["零", "一", "二", "三", "四", "五", "六", "七", "八", "九"]
单位 = ["", "十", "百", "千"]

# 到中文：95 → "九十五"，1024 → "一千零二十四"，0 → "零"，-7 → "负七"
函数 到中文(n)
    如果 n < 0
        返回 "负" + 到中文(-n)
    完毕
    如果 n > 9999
        抛出("中文数字包目前支持 0 到 9999。")
    完毕
    如果 n == 0
        返回 "零"
    完毕
    结果 = ""
    位 = 0
    当 n > 0
        个 = n % 10
        如果 个 == 0
            如果 结果 != "" 并且 取(结果, 0, 1) != "零"
                结果 = "零" + 结果
            完毕
        否则
            段 = 数位[个] + 单位[位]
            如果 位 > 0 并且 个 == 1 并且 位 == 1
                段 = "十"
            完毕
            结果 = 段 + 结果
        完毕
        n = (n - n % 10) / 10
        位 = 位 + 1
    完毕
    返回 结果
完毕

# 到数：到中文 的逆转换（支持 一 到 九千九百九十九）
函数 到数(中文)
    如果 中文 == "零"
        返回 0
    完毕
    负 = 假
    如果 取(中文, 0, 1) == "负"
        负 = 真
        中文 = 取(中文, 1)
    完毕
    数字 = {"一": 1, "二": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9}
    单位值 = {"十": 10, "百": 100, "千": 1000}
    总 = 0
    段 = 0
    当前 = 0
    for 字 于 中文
        如果 包含(数字, 字)
            当前 = 数字[字]
        又如 字 == "零"
            当前 = 0
        又如 包含(单位值, 字)
            如果 当前 == 0
                当前 = 1
            完毕
            段 = 段 + 当前 * 单位值[字]
            当前 = 0
        否则
            抛出("认不出中文数字里的字：" + 字)
        完毕
    完毕
    总 = 总 + 段 + 当前
    如果 负
        总 = -总
    完毕
    返回 总
完毕
