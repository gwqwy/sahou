# 卅· 命令行通讯录
# 运行：sahou run 通讯录.saho
#
# 结构：字典 通讯录，键是姓名（文本），值是 { "电话": 文本 }（没有类，用字典代替对象）。
# 演示：添加三个联系人 → 列出 → 查找 → 删除 → 再列出
#       → 写入文件（v1 没有 JSON，用 连接() + 循环手工拼 JSON 风格文本）→ 读回并打印。
# 全程用调用演示，不读键盘输入。

通讯录 = {}

# ── 四个函数：添加 / 查找 / 删除 / 列出 ──────────────────
函数 添加(通讯录, 姓名, 电话)
    如果 包含(通讯录, 姓名)
        返回 "「{姓名}」已经在了，电话是 {通讯录[姓名]["电话"]}。"
    完毕
    通讯录[姓名] = { "电话": 电话 }        # 字典按引用传递，调用者看得见
    返回 "已添加「{姓名}」，电话 {电话}。"
完毕

函数 查找(通讯录, 姓名)
    如果 包含(通讯录, 姓名)
        返回 "{姓名} 的电话是 {通讯录[姓名]["电话"]}。"
    否则
        返回 "查不到「{姓名}」，通讯录里没有这个人。"
    完毕
完毕

函数 删除(通讯录, 姓名)
    如果 非 包含(通讯录, 姓名)
        返回 "删不掉「{姓名}」，通讯录里没有这个人。"
    完毕
    通讯录.删除(姓名)                      # 字典成员函数：原地删除
    返回 "已删除「{姓名}」。"
完毕

函数 列出(通讯录)
    如果 长度(通讯录) == 0
        print("通讯录是空的。")
        返回 空值
    完毕
    print("通讯录里共 {长度(通讯录)} 位联系人：")
    序号 = 0
    for 姓名 于 通讯录                     # 遍历字典得到的是键
        序号 = 序号 + 1
        print("  {序号}. {姓名} — {通讯录[姓名]["电话"]}")
    完毕
    返回 空值
完毕

# ── 序列化：手工拼 JSON 风格文本（v1 没有 JSON）──────────
函数 导出文本(通讯录)
    条目列表 = []
    for 姓名 于 通讯录
        电话 = 通讯录[姓名]["电话"]
        条目列表.添加("    \"{姓名}\": \{\"电话\": \"{电话}\"\}")
    完毕
    正文 = 连接(条目列表, ",\n")
    返回 "\{\n{正文}\n\}"
完毕

# ── 1. 添加三个联系人 ────────────────────────────────────
print("== 1. 添加三个联系人 ==")
print(添加(通讯录, "张伟", "13800138000"))
print(添加(通讯录, "李娜", "13900139000"))
print(添加(通讯录, "王强", "13700137000"))

# ── 2. 列出全部 ──────────────────────────────────────────
print("")
print("== 2. 列出全部 ==")
列出(通讯录)

# ── 3. 查找一个 ──────────────────────────────────────────
print("")
print("== 3. 查找一个 ==")
print(查找(通讯录, "李娜"))
print(查找(通讯录, "赵敏"))                # 演示查不到的分支

# ── 4. 删除一个 ──────────────────────────────────────────
print("")
print("== 4. 删除一个 ==")
print(删除(通讯录, "王强"))

# ── 5. 再列出一次 ────────────────────────────────────────
print("")
print("== 5. 再列出一次 ==")
列出(通讯录)

# ── 6. 写入文件 ──────────────────────────────────────────
print("")
print("== 6. 存成 JSON 风格的文本 ==")
路径 = "通讯录.json"
写入文件(路径, 导出文本(通讯录))
print("已写入 {路径}；文件存在吗？{文件存在(路径)}")

# ── 7. 读回并打印 ────────────────────────────────────────
print("")
print("== 7. 读回文件内容 ==")
内容 = 读取文件(路径)
print(内容)
