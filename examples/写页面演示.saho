# 纯代码写页面演示 —— 像 Java Swing / Python Tkinter 一样，全部界面用 卅 代码写出来。
# 运行：sahou run examples/写页面演示.saho（Windows 下打开原生窗口，关窗即退出）

页 = 应用.写页面("乘法小测", 460, 360)

题库 = 从a到b(2, 10)
甲 = 随机.挑(题库)
乙 = 随机.挑(题库)

问句 = 页.标签("{甲} × {乙} = ?")
答案框 = 页.输入框("在这里填答案，按回车或点检查")
反馈 = 页.标签("")
计分 = 页.标签("得分：0")
页.行(问句, 答案框)
页.行(页.标签(""), 计分)

# 分数装进字典（函数里改字典内容，外层看得见；直接赋值会造出局部变量）
记分板 = { "得分": 0 }

函数 出题()
    甲 = 随机.挑(题库)
    乙 = 随机.挑(题库)
    问句.改文本("{甲} × {乙} = ?")
    答案框.改文本("")
    反馈.改文本("")
完毕

函数 检查()
    填的 = 答案框.取文本()
    尝试
        如果 数(填的) == 甲 * 乙
            记分板["得分"] = 记分板["得分"] + 10
            反馈.改文本("√ 答对啦！")
            计分.改文本("得分：{记分板["得分"]}")
            页.弹窗("答对了，加 10 分！")
            出题()
        否则
            反馈.改文本("× 再想想，提示：{甲 * 乙 % 10} 是个位的提示哦")
        完毕
    接住 错误信息
        反馈.改文本("\"{填的}\" 不是数字，直接填数就行")
    完毕
完毕

页.按钮("检查", 检查)
页.行(页.按钮("换一题", 出题), 页.标签(""))

函数 选难度(名字)
    反馈.改文本("难度选了 " + 名字 + "（演示：可以在这里改题库范围）")
完毕
页.下拉(["简单", "普通", "困难"], 选难度)

函数 切换记住(勾了吗)
    如果 勾了吗
        反馈.改文本("会记住你的得分")
    否则
        反馈.改文本("不记分了")
    完毕
完毕
页.复选("记住得分", 切换记住)

页.显示()
print("窗口已关闭，得分停在 {记分板["得分"]}")
