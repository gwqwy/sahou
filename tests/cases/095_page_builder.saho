# 纯代码写页面：无窗口构造 + 到HTML（快照测试）
页 = 应用.写页面("乘法小测", 460, 360)
问句 = 页.标签("3 × 4 = ?")
答案框 = 页.输入框("在这里填答案")
反馈 = 页.标签("")
页.行(问句, 答案框)
函数 检查()
    如果 答案框.取文本() == "12"
        反馈.改文本("√ 答对啦！")
    否则
        反馈.改文本("× 再想想")
    完毕
完毕
页.按钮("检查", 检查)
函数 选杯子(选中项)
    反馈.改文本("选了 " + 选中项)
完毕
页.下拉(["小杯", "中杯", "大杯"], 选杯子)
html = 页.到HTML()
print("标题: {包含(html, "乘法小测")}")
print("问句: {包含(html, "3 × 4 = ?")}")
print("输入框: {包含(html, "placeholder='在这里填答案'")}")
print("按钮事件: {包含(html, "事件('件5')")}")
print("下拉: {包含(html, "<option>中杯</option>")}")
print("行: {包含(html, "class='行'")}")
