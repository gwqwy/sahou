函数 加(a, b)
    返回 a + b
完毕
print(加(1, 2))
函数 无返回()
    1 + 1
完毕
print(无返回())
双倍 = 函数(x) => x * 2
print(双倍(7))
函数 应用(函数值, 值)
    返回 函数值(值)
完毕
print(应用(双倍, 5))
函数 递归(n)
    如果 n <= 1
        返回 1
    完毕
    返回 n * 递归(n - 1)
完毕
print(递归(6))
计数 = 0
函数 遮蔽()
    计数 = 99
    返回 计数
完毕
print(遮蔽())
print(计数)
外层值 = 10
函数 读外层()
    返回 外层值 + 1
完毕
print(读外层())
for i 于 从a到b(1, 3)
    1
完毕
print(i)
