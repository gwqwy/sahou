# 留言板（v1.6 全栈）：数据库存留言 + 会话记名字 + 网页模块渲染 HTML + 表单提交
# 运行：./卅.exe run examples/留言板.saho   然后浏览器打开 http://127.0.0.1:8080
库 = 数据库.打开("留言板.db")
库.执行("建 表 如无 留言 (名字, 内容)")

页面模板 = "<!doctype html><html><head><meta charset='utf-8'><title>留言板</title></head><body><h1>留言板</h1>"
页面模板 = 页面模板 + "<form method='post' action='/发留言'>名字：<input name='名字' value='[[用户]]'>"
页面模板 = 页面模板 + "<br><textarea name='内容'></textarea><br><button type='submit'>发表</button></form><hr>"
页面模板 = 页面模板 + "[[[留言列表]]]</body></html>"

函数 渲染留言(条)
    返回 "<p><b>[[名字]]</b>：[[内容]]</p>"
完毕

函数 首页(请求)
    如果 请求["方法"] == "POST"
        名字 = 请求["表单"]["名字"]
        内容 = 请求["表单"]["内容"]
        如果 名字 != "" 并且 内容 != ""
            库.执行("插入 留言 (名字, 内容) 值 (?, ?)", 名字, 内容)
            请求["会话"]["名字"] = 名字
        完毕
    完毕
    留言 = 库.查询("选择 * 出 留言")
    片段 = ""
    for 条 于 留言
        片段 = 片段 + 网页.渲染(渲染留言(条), 条)
    完毕
    用户 = ""
    如果 包含(请求["会话"], "名字")
        用户 = 请求["会话"]["名字"]
    完毕
    体 = 网页.渲染(页面模板, { "用户": 用户, "留言列表": 片段 })
    返回 { "头": { "Content-Type": "text/html; charset=utf-8" }, "体": 体 }
完毕

服务 = 网络.服务()
服务.路由("GET", "/", 首页)
服务.路由("POST", "/发留言", 首页)
print("留言板已启动：http://127.0.0.1:8080 （Ctrl+C 停止）")
服务.监听(8080)
