    { "zh": "数据库", "en": "db", "brief": "嵌入式 SQL：打开/执行/查询/表/关闭（仅服务端，JSON 单文件持久化）", "members": ["打开"] },
    { "zh": "网页", "en": "html", "brief": "服务端渲染：渲染/渲染文件/页面/转义（[[键]] 自动转义）", "members": ["转义", "渲染", "渲染文件", "页面"] },
    { "zh": "应用", "en": "app", "brief": "窗口/手机/原生窗口/写页面（纯代码控件 UI）", "members": ["打开", "窗口", "原生窗口", "写页面", "手机"] },
