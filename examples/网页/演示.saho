# 卅语言网页演示 —— 页面里的全部逻辑都是 卅
# 构建：sahou build 演示.saho -o 演示.js
用 "随机" 引入

# ---------- 状态（字典 + 函数 = 这里的"对象"） ----------
状态 = { "计数": 0, "条数": 0, "序号": 0 }

# ---------- 页面元素 ----------
计数显示 = 页面.取元素("#计数显示")
加一按钮 = 页面.取元素("#加一")
减一按钮 = 页面.取元素("#减一")
清零按钮 = 页面.取元素("#清零")
待办表单 = 页面.取元素("#待办表单")
待办输入 = 页面.取元素("#待办输入")
待办列表 = 页面.取元素("#待办列表")
空提示 = 页面.取元素("#空提示")
条数显示 = 页面.取元素("#条数显示")
金句按钮 = 页面.取元素("#换一句")
金句显示 = 页面.取元素("#金句")

金句列表 = [
    "简单是可靠的前提。",
    "先让它跑起来，再让它变好看。",
    "代码首先是写给人看的。",
    "一颗小石子也能铺出长路。",
    "少即是多。"
]

# ---------- 计数器 ----------
函数 刷新计数() {
    页面.置文本(计数显示, 状态["计数"])
    如果 状态["计数"] < 0 {
        页面.置样式(计数显示, "color", "#e11d48")
    } 否则 {
        页面.置样式(计数显示, "color", "#0f172a")
    }
}

函数 改计数(差) {
    状态["计数"] = 状态["计数"] + 差
    刷新计数()
}

函数 加一(事件) { 改计数(1) }
函数 减一(事件) { 改计数(-1) }
函数 清零(事件) {
    状态["计数"] = 0
    刷新计数()
}

页面.点击(加一按钮, 加一)
页面.点击(减一按钮, 减一)
页面.点击(清零按钮, 清零)

# ---------- 待办清单 ----------
函数 刷新条数() {
    如果 状态["条数"] == 0 {
        页面.置文本(空提示, "还没有待办，写一条试试")
        页面.置文本(条数显示, "")
    } 否则 {
        页面.置文本(空提示, "")
        页面.置文本(条数显示, "共 {状态["条数"]} 条待办 · 点文字划掉，点删除移除")
    }
}

函数 添加待办(事件) {
    内容 = 修剪(页面.值(待办输入))
    如果 内容 == "" {
        页面.置文本(空提示, "先写点内容，再点添加")
        返回
    }
    页面.置文本(空提示, "")
    状态["序号"] = 状态["序号"] + 1

    行 = 页面.创建("li")
    文本框 = 页面.创建("span")
    页面.置文本(文本框, 内容)
    删除钮 = 页面.创建("button")
    页面.置文本(删除钮, "删除")
    页面.加入(行, 文本框)
    页面.加入(行, 删除钮)
    页面.加入(待办列表, 行)

    # 每一行有自己的"完成"状态：装在字典里（函数内赋值是新建局部变量，
    # 而字典是引用——改它才是真正的改共享状态，见用户手册第 9 章）
    行状态 = { "完成": 假 }
    函数 划线(事件) {
        行状态["完成"] = 非 行状态["完成"]
        如果 行状态["完成"] {
            页面.置样式(文本框, "text-decoration", "line-through")
            页面.置样式(文本框, "opacity", "0.45")
        } 否则 {
            页面.置样式(文本框, "text-decoration", "none")
            页面.置样式(文本框, "opacity", "1")
        }
    }
    页面.点击(文本框, 划线)

    函数 删除(事件) {
        页面.移除(行)
        状态["条数"] = 状态["条数"] - 1
        刷新条数()
    }
    页面.点击(删除钮, 删除)

    页面.置值(待办输入, "")
    状态["条数"] = 状态["条数"] + 1
    刷新条数()
}

# 表单提交（回车或点添加都会触发），宿主自动阻止页面跳转
页面.提交(待办表单, 添加待办)

# ---------- 随机金句 ----------
函数 换金句(事件) {
    页面.置文本(金句显示, 随机.挑(金句列表))
}

页面.点击(金句按钮, 换金句)

# ---------- 启动 ----------
刷新计数()
刷新条数()
页面.置文本(金句显示, 随机.挑(金句列表))
