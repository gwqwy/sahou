# stones 标准库包演示 —— 在 examples/ 子目录里也能用到仓库根的 stones/（向上查找）
用 "算术库" 引入
用 "文本库" 引入
用 "游戏库" 引入
用 "中文数字" 引入
用 "统计库" 引入
用 "单位换算" 引入
用 "进制库" 引入
用 "几何库" 引入
用 "算法库" 引入

print("公约数: {算术库.最大公约数(12, 18)}")
print("约分: {算术库.约分(36, 48)}")
print("质因数分解: {算术库.质因数分解(360)}")
print("是否质数: {算术库.是否质数(97)}")
print("阶乘: {算术库.阶乘(6)}")

print(文本库.居中("卅", 11, "-"))
print("回文: {文本库.是否回文("上海自来水来自海上")}")
print("字符统计: {文本库.统计字符("abracadabra")}")
print("驼峰: {文本库.驼峰命名("user_name")}")

随机.种子(3)
print("掷骰子: {游戏库.掷骰子(6)}")
print("抛硬币: {游戏库.抛硬币()}")
print("抽奖: {游戏库.抽奖(["小明", "小红", "小刚", "小丽"], 2)}")

print("95 = {中文数字.到中文(95)}")
print("12345678 = {中文数字.到中文(12345678)}")
print("回转: {中文数字.到数(中文数字.到中文(2026))}")

分数 = [95, 58, 72, 88, 60]
print("平均: {统计库.平均值(分数)}")
print("中位数: {统计库.中位数(分数)}")
print("标准差: {统计库.标准差(分数)}")

print("体温: {单位换算.温度换算(37, "摄氏", "华氏")}")
print("百公里: {单位换算.长度换算(100, "公里", "英里")}")

print("255 的十六进制: {进制库.到十六进制(255)}")
print("FF 的十进制: {进制库.自十六进制("FF")}")
print("勾股斜边: {几何库.勾股斜边(3, 4)}")
print("海伦面积: {几何库.海伦面积(3, 4, 5)}")
print("冒泡排序: {算法库.冒泡排序([5, 2, 8, 1])}")
print("二分查找: {算法库.二分查找([1, 2, 5, 8], 5)}")
