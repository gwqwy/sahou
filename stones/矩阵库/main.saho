# 矩阵库 —— 纯 sahou 实现的矩阵基础运算（v2 标准库 stones 包）
# 矩阵用"列表的列表"表示，按行存放：[[1,2],[3,4]] 是 2×2。
# 只依赖核心内置函数，宿主与浏览器（经 sahou build）都能用。

# 单位矩阵：单位矩阵(3) 得 3×3 单位矩阵（对角线是 1，其余是 0）
函数 单位矩阵(n)
    如果 n < 1
        抛出("矩阵至少要有 1 行 1 列。")
    完毕
    结果 = []
    for i 于 从a到b(0, n)
        行 = []
        for j 于 从a到b(0, n)
            如果 i == j
                行.添加(1)
            否则
                行.添加(0)
            完毕
        完毕
        结果.添加(行)
    完毕
    返回 结果
完毕

# 矩阵加：对应位置相加，形状不同报错
函数 加(甲, 乙)
    行数 = 长度(甲)
    列数 = 长度(甲[0])
    如果 行数 != 长度(乙) 或者 列数 != 长度(乙[0])
        抛出("两个矩阵形状不同，加不了。")
    完毕
    结果 = []
    for i 于 从a到b(0, 行数)
        行 = []
        for j 于 从a到b(0, 列数)
            行.添加(甲[i][j] + 乙[i][j])
        完毕
        结果.添加(行)
    完毕
    返回 结果
完毕

# 矩阵乘：乘(甲, 乙)，左边矩阵的列数要等于右边矩阵的行数
函数 乘(甲, 乙)
    内径 = 长度(甲[0])
    如果 内径 != 长度(乙)
        抛出("左边矩阵的列数要等于右边矩阵的行数，乘不了。")
    完毕
    结果 = []
    for i 于 从a到b(0, 长度(甲))
        行 = []
        for j 于 从a到b(0, 长度(乙[0]))
            和 = 0
            for k 于 从a到b(0, 内径)
                和 = 和 + 甲[i][k] * 乙[k][j]
            完毕
            行.添加(和)
        完毕
        结果.添加(行)
    完毕
    返回 结果
完毕

# 转置：行列互换。转置([[1,2],[3,4]]) 得 [[1, 3], [2, 4]]
函数 转置(甲)
    结果 = []
    for j 于 从a到b(0, 长度(甲[0]))
        行 = []
        for i 于 从a到b(0, 长度(甲))
            行.添加(甲[i][j])
        完毕
        结果.添加(行)
    完毕
    返回 结果
完毕

# 行列式：只支持 2×2 和 3×3。行列式([[1,2],[3,4]]) 得 -2
函数 行列式(甲)
    如果 长度(甲) == 2 并且 长度(甲[0]) == 2
        返回 甲[0][0] * 甲[1][1] - 甲[0][1] * 甲[1][0]
    完毕
    如果 长度(甲) == 3 并且 长度(甲[0]) == 3
        子甲 = 甲[1][1] * 甲[2][2] - 甲[1][2] * 甲[2][1]
        子乙 = 甲[1][0] * 甲[2][2] - 甲[1][2] * 甲[2][0]
        子丙 = 甲[1][0] * 甲[2][1] - 甲[1][1] * 甲[2][0]
        返回 甲[0][0] * 子甲 - 甲[0][1] * 子乙 + 甲[0][2] * 子丙
    完毕
    抛出("行列式只支持 2×2 和 3×3 矩阵。")
完毕

# 矩阵文本：排成竖线表格，方便打印查看。矩阵文本([[2,1],[4,3]]) 得
#   | 2 1 |
#   | 4 3 |
# 两行文本（用 \n 分隔）
函数 矩阵文本(甲)
    行文本 = []
    for 行 于 甲
        行文本.添加("| " + 连接(行, " ") + " |")
    完毕
    返回 连接(行文本, "\n")
完毕
