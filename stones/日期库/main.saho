# 日期库 —— 纯 sahou 实现的公历日期计算（v2 标准库 stones 包）
# 不依赖 系统/时间 模块，宿主与浏览器（经 sahou build）都能用。
# 按现在的公历规则推算，不处理 1582 年以前的历史历法切换。

# 是否闰年：能被 4 整除但不能被 100 整除，或者能被 400 整除
函数 是否闰年(年)
    返回 (年 % 4 == 0 并且 年 % 100 != 0) 或者 年 % 400 == 0
完毕

# 月份天数：该年该月有几天（二月按闰年算 29 天）；月份写 1 到 12
函数 月份天数(年, 月)
    如果 月 < 1 或者 月 > 12
        抛出("月份要在 1 到 12 之间，收到 " + 文本(月) + "。")
    完毕
    每月天数 = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    如果 月 == 2 并且 是否闰年(年)
        返回 29
    完毕
    返回 每月天数[月 - 1]
完毕

# 是否合法日期：年月日拼在一起是不是真实存在的一天
函数 是否合法日期(年, 月, 日)
    如果 月 < 1 或者 月 > 12
        返回 假
    完毕
    返回 日 >= 1 并且 日 <= 月份天数(年, 月)
完毕

# 星期几：用蔡勒公式推算，返回 "日" "一" … "六"。
# 星期几(2026, 9, 19) 得 "六"
函数 星期几(年, 月, 日)
    如果 非 是否合法日期(年, 月, 日)
        抛出(文本(年) + " 年 " + 文本(月) + " 月 " + 文本(日) + " 日不是真实存在的日期。")
    完毕
    # 一二月当作上一年的 13、14 月来算（蔡勒公式的约定）
    如果 月 < 3
        月 = 月 + 12
        年 = 年 - 1
    完毕
    世纪头 = 取整数部分(年 / 100)
    世纪尾 = 年 % 100
    序头 = 取整数部分((13 * (月 + 1)) / 5) + 取整数部分(世纪尾 / 4)
    序 = (日 + 序头 + 世纪尾 + 取整数部分(世纪头 / 4) + 5 * 世纪头) % 7
    名字表 = ["六", "日", "一", "二", "三", "四", "五"]
    返回 名字表[序]
完毕

# 相隔天数：两个日期之间差几天（后者减前者，倒着算得到负数）。
# 内部先把每个日期折成"儒略日数"（天文上连续 numbering 天的整数），再相减。
# 相隔天数(2026, 1, 1, 2026, 10, 1) 得 273
函数 相隔天数(年1, 月1, 日1, 年2, 月2, 日2)
    返回 儒略日数(年2, 月2, 日2) - 儒略日数(年1, 月1, 日1)
完毕

# ── 内部辅助 ─────────────────────────

# 儒略日数：把公历日期折成一个连续递增的整数（当天正午的儒略日数）。
# 公式是天文上通用的 Fliegel–Van Flandern 算法，全部用整数除法。
# 2026-09-19 的儒略日数是 2461303。
函数 儒略日数(年, 月, 日)
    头 = 取整数部分((14 - 月) / 12)
    扩年 = 年 + 4800 - 头
    扩月 = 月 + 12 * 头 - 3
    年部分 = 365 * 扩年 + 取整数部分(扩年 / 4) - 取整数部分(扩年 / 100)
    返回 日 + 取整数部分((153 * 扩月 + 2) / 5) + 年部分 + 取整数部分(扩年 / 400) - 32045
完毕

# 取整数部分：小数的整数部分（向零取整），与 算术库.取整数值 同思路
函数 取整数部分(x)
    段 = 分割(文本(x), ".")
    如果 长度(段) == 1
        返回 x
    完毕
    返回 数(段[0])
完毕
