{
  "$note": "卅语言（sahou）编辑器共享元数据 —— 各编辑器集成（VS Code/JetBrains/Sublime/Vim…）的唯一数据来源。改动后运行 node editors/sync-shared.js 同步到各编辑器目录。与 docs/00-设计决策简报.md、02-语言规范.md 保持一致。",
  "language": {
    "id": "sahou",
    "name": "卅",
    "nameEn": "sahou",
    "extensions": [".saho"],
    "lineComment": "#",
    "pipeOperator": "->",
    "pipeAlias": "→",
    "pipePlaceholder": "它",
    "projectSite": "https://github.com/gwqwy/sahou"
  },
  "keywords": [
    { "zh": "如果", "en": "if", "kind": "control", "brief": "条件：如果 条件 … 完毕" },
    { "zh": "又如", "en": "elif", "kind": "control", "brief": "否则再判断" },
    { "zh": "否则", "en": "else", "kind": "control", "brief": "其余情况" },
    { "zh": "当", "en": "while", "kind": "control", "brief": "循环：当 条件 … 完毕" },
    { "zh": "遍历", "en": "for", "kind": "control", "brief": "循环：遍历 x 于 序列" },
    { "zh": "于", "en": "in", "kind": "control", "brief": "遍历的连接词" },
    { "zh": "跳出", "en": "break", "kind": "control", "brief": "结束最近一层循环（v4.1）" },
    { "zh": "继续", "en": "continue", "kind": "control", "brief": "跳过本轮循环（v4.1）" },
    { "zh": "完毕", "en": "end", "kind": "control", "brief": "结束一个块（也可用花括号）" },
    { "zh": "函数", "en": "fn", "kind": "decl", "brief": "定义函数，或匿名 函数(x) => 表达式" },
    { "zh": "返回", "en": "return", "kind": "decl", "brief": "从函数返回值" },
    { "zh": "设", "en": "let", "kind": "decl", "brief": "可选的赋值前缀，写不写都可以" },
    { "zh": "格子", "en": "cell", "kind": "decl", "brief": "响应式变量：格子 总价 = 单价 * 数量（v4）" },
    { "zh": "真", "en": "true", "kind": "literal", "brief": "布尔真" },
    { "zh": "假", "en": "false", "kind": "literal", "brief": "布尔假" },
    { "zh": "空值", "en": "null", "kind": "literal", "brief": "没有值" },
    { "zh": "并且", "en": "and", "kind": "operator", "brief": "逻辑与（短路）" },
    { "zh": "或者", "en": "or", "kind": "operator", "brief": "逻辑或（短路）" },
    { "zh": "非", "en": "not", "kind": "operator", "brief": "逻辑非" },
    { "zh": "尝试", "en": "try", "kind": "control", "brief": "尝试块开始" },
    { "zh": "接住", "en": "catch", "kind": "control", "brief": "接住错误信息" },
    { "zh": "用", "en": "use", "kind": "decl", "brief": "引入模块或 stones 包：用 \"模块名\" 引入" },
    { "zh": "引入", "en": "import", "kind": "decl", "brief": "引入语句的收尾（可省略）" }
  ],
  "builtins": [
    { "zh": "打印", "en": "print", "signature": "打印(值, 结尾: \"\\n\")", "brief": "把值打印到屏幕，结尾可改", "side": "双端" },
    { "zh": "输入", "en": "input", "signature": "输入(提示: \"\")", "brief": "等用户输入一行，返回文本", "side": "服务端" },
    { "zh": "数", "en": "num", "signature": "数(值)", "brief": "把文本/布尔转成数；失败抛错（别名 文本转数/str_to_num）", "side": "双端" },
    { "zh": "文本", "en": "str", "signature": "文本(值)", "brief": "把任意值转成文本", "side": "双端" },
    { "zh": "列表", "en": "list", "signature": "列表(值?)", "brief": "空列表/浅拷贝/字典的键列表", "side": "双端" },
    { "zh": "字典", "en": "dict", "signature": "字典(配对列表?)", "brief": "空字典或由 [键, 值] 对构造", "side": "双端" },
    { "zh": "从a到b", "en": "range_to", "signature": "从a到b(a, b, 步长: 1)", "brief": "生成含头不含尾的等差列表", "side": "双端" },
    { "zh": "长度", "en": "len", "signature": "长度(列表|文本|字典)", "brief": "元素数/字符数/键数", "side": "双端" },
    { "zh": "取", "en": "slice", "signature": "取(序列, 起: 0, 止, 步长: 1)", "brief": "取一段（半开区间），替代切片语法", "side": "双端" },
    { "zh": "抛出", "en": "throw", "signature": "抛出(消息文本)", "brief": "主动抛错，可被 接住", "side": "双端" },
    { "zh": "类型", "en": "type_of", "signature": "类型(值)", "brief": "返回 \"number\"/\"string\"/…", "side": "双端" },
    { "zh": "包含", "en": "contains", "signature": "包含(容器, 值)", "brief": "列表含元素/字典含键/文本含子串", "side": "双端" },
    { "zh": "求和", "en": "sum", "signature": "求和(列表)", "brief": "所有数相加", "side": "双端" },
    { "zh": "最大值", "en": "max", "signature": "最大值(列表)", "brief": "最大元素", "side": "双端" },
    { "zh": "最小值", "en": "min", "signature": "最小值(列表)", "brief": "最小元素", "side": "双端" },
    { "zh": "排序", "en": "sorted", "signature": "排序(列表, 降序: 假)", "brief": "返回新排序列表", "side": "双端" },
    { "zh": "反转", "en": "reversed", "signature": "反转(列表|文本)", "brief": "返回倒序副本", "side": "双端" },
    { "zh": "连接", "en": "join", "signature": "连接(列表, 分隔: \"\")", "brief": "元素转文本后连接", "side": "双端" },
    { "zh": "分割", "en": "split", "signature": "分割(文本, 分隔: \" \")", "brief": "按分隔符切成列表", "side": "双端" },
    { "zh": "替换", "en": "replace", "signature": "替换(文本, 旧, 新)", "brief": "全部替换，返回新文本", "side": "双端" },
    { "zh": "修剪", "en": "trim", "signature": "修剪(文本)", "brief": "去首尾空白", "side": "双端" },
    { "zh": "转大写", "en": "upper", "signature": "转大写(文本)", "brief": "字母转大写", "side": "双端" },
    { "zh": "转小写", "en": "lower", "signature": "转小写(文本)", "brief": "字母转小写", "side": "双端" },
    { "zh": "绝对值", "en": "abs", "signature": "绝对值(数)", "brief": "绝对值", "side": "双端" },
    { "zh": "平方根", "en": "sqrt", "signature": "平方根(数)", "brief": "平方根；负数报错", "side": "双端" },
    { "zh": "四舍五入", "en": "round", "signature": "四舍五入(数, 小数位: 0)", "brief": "按位四舍五入", "side": "双端" },
    { "zh": "读取文件", "en": "read_file", "signature": "读取文件(路径)", "brief": "UTF-8 读整个文件", "side": "服务端" },
    { "zh": "写入文件", "en": "write_file", "signature": "写入文件(路径, 内容)", "brief": "覆盖写入（自动建父目录）", "side": "服务端" },
    { "zh": "文件存在", "en": "file_exists", "signature": "文件存在(路径)", "brief": "路径是否存在", "side": "服务端" },
    { "zh": "位置", "en": "find", "signature": "位置(文本, 子文本)", "brief": "子文本首次出现的下标；找不到 -1（第 30 个内置函数）", "side": "双端" }
  ],
  "modules": [
    { "zh": "网络", "en": "net", "brief": "后端：服务.路由/监听、请求、自文本/到文本（JSON）、JSON回应/网页回应/重定向", "members": ["服务", "请求", "自文本", "到文本"] },
    { "zh": "页面", "en": "page", "brief": "前端（转译后）：取元素/置文本/点击/绑定/绑输入 等 DOM 能力", "members": [] },
