# 进制库 —— 纯 sahou 实现的进制转换（2 到 36 进制，v2 标准库 stones 包）
# 只依赖核心内置函数，宿主与浏览器（经 sahou build）都能用。

数表 = "0123456789abcdefghijklmnopqrstuvwxyz"

# 到进制：把整数写成 基数 进制文本。到进制(255, 16) 得 "ff"，到进制(5, 2) 得 "101"
函数 到进制(值, 基数)
    如果 基数 < 2 或者 基数 > 36
        抛出("进制要在 2 到 36 之间，收到的是 {基数}。")
    完毕
    如果 值 % 1 != 0
        抛出("进制转换要整数，收到的是 {值}。")
    完毕
    如果 值 < 0
        返回 "-" + 到进制(-值, 基数)
    完毕
    如果 值 == 0
        返回 "0"
    完毕
    结果 = ""
    当 值 > 0
        余 = 值 % 基数
        结果 = 取(数表, 余, 余 + 1) + 结果
        值 = (值 - 余) / 基数
    完毕
    返回 结果
完毕

# 自进制：把 基数 进制文本转回数。自进制("ff", 16) 得 255，自进制("-101", 2) 得 -5
函数 自进制(文, 基数)
    如果 基数 < 2 或者 基数 > 36
        抛出("进制要在 2 到 36 之间，收到的是 {基数}。")
    完毕
    如果 文 == ""
        抛出("进制文本不能是空的。")
    完毕
    负 = 假
    如果 取(文, 0, 1) == "-"
        负 = 真
        文 = 取(文, 1)
    完毕
    如果 文 == ""
        抛出("减号后面要有数字。")
    完毕
    总 = 0
    for 字 于 文
        位 = 位置(数表, 字)
        如果 位 < 0 或者 位 >= 基数
            抛出("\"{字}\" 不是 {基数} 进制的数位。")
        完毕
        总 = 总 * 基数 + 位
    完毕
    如果 负
        总 = -总
    完毕
    返回 总
完毕

# 到二进制：到二进制(5) 得 "101"
函数 到二进制(值)
    返回 到进制(值, 2)
完毕

# 自二进制：自二进制("101") 得 5
函数 自二进制(文)
    返回 自进制(文, 2)
完毕

# 到八进制：到八进制(64) 得 "100"
函数 到八进制(值)
    返回 到进制(值, 8)
完毕

# 到十六进制：字母用大写。到十六进制(255) 得 "FF"
函数 到十六进制(值)
    返回 转大写(到进制(值, 16))
完毕

# 自十六进制：大小写都认。自十六进制("FF") 得 255
函数 自十六进制(文)
    返回 自进制(转小写(文), 16)
完毕
