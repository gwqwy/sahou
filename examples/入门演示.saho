# 卅· 入门演示

# ── 变量与数 ──────────────────────────
价格 = 3.5
数量 = 4
print("总价是 {价格 * 数量} 元")          # 总价是 14 元
print("10 == 10.0 是 {10 == 10.0}")      # 真：只有一种数
print("10 / 3 = {10 / 3}")               # 3.33333333333333

# ── 条件 ──────────────────────────────
分数 = 87
如果 分数 >= 90
    print("优秀")
又如 分数 >= 60
    print("及格")
否则
    print("要加油")
完毕

# ── 循环：两种 ────────────────────────
计数 = 0
当 计数 < 3
    计数 = 计数 + 1
完毕
print("当循环跑了 {计数} 次")

平方数 = []
for i 于 从a到b(1, 6)
    平方数.添加(i * i)
完毕
print("平方数: {平方数}")

# ── 函数：递归也行 ────────────────────
函数 阶乘(n)
    如果 n <= 1
        返回 1
    完毕
    返回 n * 阶乘(n - 1)
完毕

print("5! = {阶乘(5)}")

# ── 字典 + 函数代替"对象" ─────────────
小猫 = { "名字": "咪咪", "饥饿": 30 }

函数 喂食(动物)
    动物["饥饿"] = 动物["饥饿"] - 10
    返回 "{动物["名字"]} 吃饱啦，饥饿度 {动物["饥饿"]}"
完毕

print(喂食(小猫))

# ── 尝试 / 接住 ───────────────────────
尝试
    print(数("不是数字"))
接住 错误信息
    print("出错了: {错误信息}")
完毕
