# 桌面应用（v1.7 应用模块）：先用 网页 模块写一个页面文件，再用 应用.窗口 打开它。
# 运行：./卅.exe run examples/桌面应用.saho  —— 会自动弹出浏览器窗口，Ctrl+C 退出。
模板 = "<!doctype html><html><head><meta charset='utf-8'><title>[[标题]]</title></head><body>"
模板 = 模板 + "<h1>[[标题]]</h1><p>这是一个用 卅 写的桌面应用（浏览器壳）。</p>"
模板 = 模板 + "<button onclick='点击.数 = 点击.数 + 1'>点我</button>"
模板 = 模板 + "</body></html>"
模板 = 模板 + "<script>点击 = {数: 0}; document.querySelector('button').addEventListener('click', "
模板 = 模板 + "function() { document.querySelector('h1').textContent = '点了 ' + 点击.数 + ' 次'; })</script>"
写入文件("应用页面/index.html", 网页.渲染(模板, {"标题": "你好，桌面"}))
print("页面已生成，正在打开应用窗口……")
应用.窗口("应用页面")
